{
	"schemaVersion": 1,
	"id": "mochaccino",
	"version": "${version}",
	"name": "Mochaccino",
	"description": "A mod that adds native Menu Bar and Dock features on macOS",
	"authors": [
		"tomato potato"
	],
	"contact": {
		"homepage": "https://github.com/tomatopotato17265/mochaccino",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/mochaccino/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"tomatopotato.mochaccino.Mochaccino"
		],
		"client": [
			"tomatopotato.mochaccino.client.MochaccinoClient"
		]
	},
	"mixins": [
		"mochaccino.mixins.json",
		{
			"config": "mochaccino.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}